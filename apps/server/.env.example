# apps/server — 서버에만 존재하는 환경 변수 (.env로 복사해 사용)
# 노션 연동은 OAuth(Public Integration) — 단일 API 키(NOTION_API_KEY) 방식 폐기.
# 사용자별 액세스 토큰은 env가 아니라 DB에 저장된다.
NOTION_OAUTH_CLIENT_ID=xxx
NOTION_OAUTH_CLIENT_SECRET=xxx
# 색인용 워크스페이스 연결 인가의 콜백
NOTION_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/notion/callback
# "노션으로 로그인" 인가 — 별도 통합의 client id/secret·콜백.
# 로그인 인가에서 받은 노션 토큰은 사용자 식별에만 쓰고 저장하지 않는다 (sharing.md).
# LOGIN_CLIENT_ID/SECRET을 비워두면 색인용(NOTION_OAUTH_CLIENT_ID/SECRET)으로 폴백한다.
NOTION_OAUTH_LOGIN_CLIENT_ID=xxx
NOTION_OAUTH_LOGIN_CLIENT_SECRET=xxx
NOTION_OAUTH_LOGIN_REDIRECT_URI=http://localhost:8787/auth/notion/callback

# 임베딩 — Gemini API (12단계). 발급: https://aistudio.google.com/apikey
# 서버 전용. 미설정 시 서버가 기동되지 않는다. 데스크탑 앱에는 내려보내지 않는다.
GEMINI_API_KEY=xxx

# 노션 토큰 암호화 키(AES-256-GCM) — 32바이트 base64. 미설정 시 서버가 기동되지 않는다.
# 생성: openssl rand -base64 32
MINUTES_ENCRYPTION_KEY=xxx

# Ollama 복귀 시 되살린다 (docker compose 사용 시 compose가 http://ollama:11434로 덮어쓴다)
# OLLAMA_BASE_URL=http://localhost:11434
SQLITE_PATH=./data/minutes.db
PORT=8787
