# apps/server — 서버에만 존재하는 환경 변수 (.env로 복사해 사용)
# 노션 연동은 OAuth(Public Integration) — 단일 API 키(NOTION_API_KEY) 방식 폐기.
# 사용자별 액세스 토큰은 env가 아니라 DB에 저장된다.
NOTION_OAUTH_CLIENT_ID=xxx
NOTION_OAUTH_CLIENT_SECRET=xxx
NOTION_OAUTH_REDIRECT_URI=http://localhost:8787/oauth/notion/callback

# docker compose 사용 시 compose가 http://ollama:11434로 덮어쓴다
OLLAMA_BASE_URL=http://localhost:11434
SQLITE_PATH=./data/minutes.db
PORT=8787
