{
  "name": "minutes",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run --cwd apps/desktop dev",
    "tauri:dev": "bun run --cwd apps/desktop tauri:dev",
    "tauri:build": "bun run --cwd apps/desktop tauri:build",
    "server:dev": "bun run --cwd apps/server dev",
    "test": "bun run --cwd apps/server test && bun run --cwd apps/desktop test",
    "typecheck": "bun run --cwd apps/server typecheck && bun run --cwd apps/desktop typecheck && bun run --cwd packages/core typecheck",
    "index:all": "bun run --cwd apps/server index:all",
    "index:incremental": "bun run --cwd apps/server index:incremental",
    "search": "bun run --cwd apps/server search",
    "eval": "bun run --cwd apps/server eval",
    "db:migrate": "bun run --cwd apps/server db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
